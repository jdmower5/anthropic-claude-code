# Jobber OAuth 2.0 credentials
# Get these from https://developer.getjobber.com
JOBBER_CLIENT_ID=your_client_id_here
JOBBER_CLIENT_SECRET=your_client_secret_here

# Base URL for OAuth callback redirect
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Anthropic API key — powers the marketing agent's content generation.
# Without this, the agent falls back to on-brand templates so it still works locally.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
